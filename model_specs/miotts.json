{
  "family": "miotts",
  "display_name": "MioTTS",
  "description": "Lightweight LLM-based English and Japanese TTS family built on MioCodec, supporting low-latency speech generation and zero-shot voice cloning from short reference audio.",
  "category": "tts",
  "status": "supported",
  "tasks": [
    "tts",
    "clone"
  ],
  "modes": [
    "offline"
  ],
  "languages": [
    "en",
    "ja"
  ],
  "capabilities": {
    "clone": [
      "speaker_reference"
    ]
  },
  "runtime": {
    "tags": [
      "gguf"
    ]
  },
  "ui": {
    "recommended_package": "miotts_1_7b_q8_0",
    "tags": [
      "TTS",
      "Clone",
      "GGUF"
    ],
    "docs": [
      "docs/models/miotts.md",
      "docs/tts.md",
      "docs/gguf.md"
    ]
  },
  "package_defaults": {
    "download": {
      "kind": "huggingface_snapshot",
      "repo": "audio-cpp/audio.cpp-gguf",
      "revision": "main",
      "gated": false
    }
  },
  "packages": [
    {
      "id": "miotts_1_7b_q8_0",
      "display_name": "MioTTS 1.7B Q8_0 GGUF",
      "default": true,
      "format": "gguf",
      "precision": "q8_0",
      "target_directory": "MioTTS-1.7B-GGUF",
      "files": [
        "MioTTS-1.7B-GGUF/miotts-1.7b-q8_0.gguf"
      ],
      "strip_prefix": "MioTTS-1.7B-GGUF"
    },
    {
      "id": "miotts_1_7b_bf16",
      "display_name": "MioTTS 1.7B BF16 GGUF",
      "format": "gguf",
      "precision": "bf16",
      "target_directory": "MioTTS-1.7B-GGUF",
      "files": [
        "MioTTS-1.7B-GGUF/miotts-1.7b-bf16.gguf"
      ],
      "strip_prefix": "MioTTS-1.7B-GGUF"
    },
    {
      "id": "miotts_1_7b_orig",
      "display_name": "MioTTS 1.7B Original-Dtype GGUF",
      "format": "gguf",
      "precision": "orig",
      "target_directory": "MioTTS-1.7B-GGUF",
      "files": [
        "MioTTS-1.7B-GGUF/miotts-1.7b-orig.gguf"
      ],
      "strip_prefix": "MioTTS-1.7B-GGUF"
    }
  ],
  "sources": [
    {
      "format": "gguf",
      "roots": {
        "model": ".",
        "weights": "$gguf"
      },
      "files": {
        "config": "model:config.json",
        "generation_config": "model:generation_config.json",
        "tokenizer_config": "model:tokenizer_config.json",
        "vocab": "model:vocab.json",
        "merges": "model:merges.txt"
      },
      "optional_files": {
        "tokenizer_json": "model:tokenizer.json"
      },
      "tensors": {
        "weights": "weights:"
      }
    },
    {
      "format": "safetensors",
      "roots": {
        "model": "."
      },
      "files": {
        "config": "model:config.json",
        "generation_config": "model:generation_config.json",
        "tokenizer_config": "model:tokenizer_config.json",
        "vocab": "model:vocab.json",
        "merges": "model:merges.txt"
      },
      "optional_files": {
        "tokenizer_json": "model:tokenizer.json"
      },
      "tensors": {
        "weights": "model:model.safetensors"
      }
    }
  ],
  "options": {
    "session": [
      {
        "name": "codec_model_path",
        "type": "string",
        "description": "MioCodec model directory used by MioTTS acoustic decoding."
      },
      {
        "name": "best_of_n_enabled",
        "type": "bool",
        "description": "Enable best-of-N candidate selection by default."
      },
      {
        "name": "best_of_n_default",
        "type": "int",
        "min": 1,
        "description": "Default best-of-N candidate count."
      },
      {
        "name": "best_of_n_max",
        "type": "int",
        "min": 1,
        "description": "Maximum best-of-N candidate count."
      },
      {
        "name": "best_of_n_language",
        "type": "enum",
        "values": [
          "auto",
          "en",
          "ja"
        ],
        "description": "Default language used when scoring best-of-N candidates."
      },
      {
        "name": "best_of_n_asr_model_path",
        "type": "string",
        "description": "Qwen3-ASR model directory used by best-of-N scoring."
      },
      {
        "name": "weight_type",
        "type": "enum",
        "values": [
          "native",
          "f32",
          "f16",
          "bf16",
          "q8_0"
        ],
        "description": "MioTTS language-model matmul weight storage type."
      },
      {
        "name": "codec_constant_context_mb",
        "type": "int",
        "min": 1,
        "description": "Runtime workspace size in MiB; unset preserves the model default."
      },
      {
        "name": "codec_weight_context_mb",
        "type": "int",
        "min": 1,
        "description": "Runtime workspace size in MiB; unset preserves the model default."
      },
      {
        "name": "decode_graph_arena_mb",
        "type": "int",
        "min": 1,
        "description": "Runtime workspace size in MiB; unset preserves the model default."
      },
      {
        "name": "global_graph_arena_mb",
        "type": "int",
        "min": 1,
        "description": "Runtime workspace size in MiB; unset preserves the model default."
      },
      {
        "name": "prefill_graph_arena_mb",
        "type": "int",
        "min": 1,
        "description": "Runtime workspace size in MiB; unset preserves the model default."
      },
      {
        "name": "wave_graph_arena_mb",
        "type": "int",
        "min": 1,
        "description": "Runtime workspace size in MiB; unset preserves the model default."
      },
      {
        "name": "weight_context_mb",
        "type": "int",
        "min": 1,
        "description": "Runtime workspace size in MiB; unset preserves the model default."
      }
    ]
  }
}
