# --- local dev environment / editor tooling (not for the repo) ---
/venv/
/.codegraph/
/.cursor/
/.claude/
/.playwright-mcp/

# --- portable bundle: distributed manually, never committed ---
/audiocpp-portable/
/_update/
/AGENTS.md
/CLAUDE.md

# --- WebUI runtime artifacts: keep the source + empty dirs, drop generated files ---
/webui/output/*
!/webui/output/.gitkeep
/webui/logs/*
!/webui/logs/.gitkeep
/webui/third_party/
/webui/llm_api_key.txt
# written by the in-UI language picker; per-machine, not a project setting
/webui/configs/ui_language.json
/webui/configs/workbench_downloads.json
/webui/configs/workbench_downloads.json.tmp
# Shared reference voices can be committed; personal recordings stay local.
/webui/voice/[mM][yY]-[rR][eE][cC]*
/webui/voice/[dD][lL][cC]*
/webui/voice/ref-w1.wav

# --- upstream native WebUI build artifacts ---
/webui/native/node_modules/
/webui/native/.svelte-kit/
/webui/native/dist/*
!/webui/native/dist/index.html
